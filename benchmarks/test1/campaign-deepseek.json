{
  "version": 1,
  "models": ["deepseek/deepseek-v4-flash-0731"],
  "agents": [{
    "id": "pi-gentle",
    "kind": "pi",
    "command": ["gentle-shell", "--link"]
  }],
  "tasks": [{
    "id": "csv-report",
    "prompt": "Read data/numbers.csv and write the integer sum to report.txt, followed by a newline.",
    "image": "aqp-agentsbench/pi-gentle-python:0.1.0",
    "attachments": [{"source": "numbers.csv", "target": "data/numbers.csv"}],
    "evaluation": {
      "files": [{"source": "check.py", "target": "check.py"}],
      "tests": [
        {"id": "correct-total", "score": 4, "command": ["python", "/evaluation/check.py", "total"]},
        {"id": "output-format", "score": 1, "command": ["python", "/evaluation/check.py", "format"]}
      ]
    }
  }]
}
